# Copy to .env for local development. Set the same variables in the hosting dashboard
# (Vercel: Project > Settings > Environment Variables). None of these are secrets: they are
# public identifiers that end up in the page HTML.

# Where the enquiry form posts (a form service endpoint, e.g. Formspree or Web3Forms).
# Without it the form is shown but submissions are disabled with a clear message.
PUBLIC_FORM_ENDPOINT=

# Optional: Web3Forms needs its public access key sent with the form.
PUBLIC_FORM_ACCESS_KEY=

# Analytics (optional, pick one). Without either, no analytics script is loaded.
PUBLIC_PLAUSIBLE_DOMAIN=
PUBLIC_GA4_ID=

# Google Search Console HTML-tag verification code (the content="…" value only).
PUBLIC_GSC_VERIFICATION=

# Preview deployments (Vercel previews, Cloudflare Pages branches other than main) are built
# with noindex and a blocking robots.txt automatically.
