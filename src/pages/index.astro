---
import { getEntries, getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ArticleCard from '../components/ArticleCard.astro';
import CtaBand from '../components/CtaBand.astro';
import SystemsDiagram from '../components/SystemsDiagram.astro';
import FeaturedProject from '../components/FeaturedProject.astro';
import CaseGrid from '../components/CaseGrid.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import Icon from '../components/Icon.astro';
import LogoStrip from '../components/LogoStrip.astro';
import { SITE, CTA } from '../data/site';
import { PILLARS, REQUESTS } from '../data/pillars';
import { CAPABILITIES } from '../data/capabilities';
import { projects, articles } from '../data/content';

// Page story: what I do → proof → how I work → where → who → start a conversation.

const pillars = await Promise.all(
  PILLARS.map(async (p) => ({
    ...p,
    links: (await getEntries(p.services.map((id) => ({ collection: 'services' as const, id })))).map((s) => ({
      label: s.data.shortTitle,
      href: `/services/${s.id}/`,
    })),
  })),
);

const allProjects = await projects();
// Lead with the strongest featured project that has real screens, then three more. Never the whole catalogue.
const lead = allProjects.find((p) => p.data.featured && p.data.screenshots.length > 0) ?? allProjects[0];
const moreProjects = allProjects.filter((p) => p !== lead).slice(0, 3);
const latest = (await articles()).slice(0, 3);
const markets = (await getCollection('markets')).sort((a, b) => a.data.order - b.data.order);
const shortCountry = (c: string) => (c === 'United Arab Emirates' ? 'UAE' : c);

const process = [
  { title: 'Talk it through', text: 'A conversation about the problem, your systems and what a good result looks like.' },
  { title: 'Agree the plan', text: 'Clear scope, approach, stages and risks, written down before work starts.' },
  { title: 'Deliver in stages', text: 'Working results early, tested with realistic data and reviewed with you.' },
  { title: 'Support and improve', text: 'Go-live, handover and ongoing improvement based on how it is used.' },
];
---

<Base title={SITE.title} fullTitle description={SITE.description}>
  <!-- 1. The promise -->
  <section class="hero">
    <div class="container">
      <div class="hero__grid">
        <div>
          <span class="kicker">Technology partner for growing businesses</span>
          <h1>I build, connect and automate <span>the software your business runs on.</span></h1>
          <p class="lead">
            Systems integration, workflow automation, AI and custom software for businesses in the UAE, New Zealand and
            beyond. One accountable partner, from the first conversation to a working system.
          </p>
          <div class="actions">
            <a class="button" href={CTA.href} data-cta="home-hero">{CTA.label}</a>
            <a class="button button--outline-light" href="#work">See the work</a>
          </div>
        </div>
        <SystemsDiagram />
      </div>

      <div class="requests">
        <p>Businesses come to me to…</p>
        <ul>{REQUESTS.map((r) => <li>{r}</li>)}</ul>
      </div>
    </div>
  </section>

  <!-- 2. What I do -->
  <section class="section" id="what-i-do">
    <div class="container">
      <LogoStrip items={allProjects} />
      <SectionHeader
        center
        eyebrow="What I do"
        title="Four ways I help businesses run better"
        intro="Most projects combine more than one. Each starts from the business problem, not from a technology."
      />
      <div class="pillars">
        {
          pillars.map((p) => (
            <article class="pillar">
              <div class="pillar__icon">
                <Icon name={p.icon} />
              </div>
              <h3>{p.title}</h3>
              <p>{p.text}</p>
              <ul>
                {[...p.links, ...p.extra].map((l) => (
                  <li>
                    <a href={l.href}>{l.label}</a>
                  </li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
      <p class="also">
        <strong>Also:</strong>
        {CAPABILITIES.slice(0, 6).map((c) => c.title.toLowerCase()).join(', ')} and more.
        <a href="/services/#capabilities">Everything I do →</a>
      </p>
    </div>
  </section>

  <!-- 3. Proof -->
  <section class="section section--soft" id="work">
    <div class="container">
      <SectionHeader
        eyebrow="Proof of work"
        title="Products and client projects"
        intro="Real work, each labelled for who owns it and how far it has got."
        action={{ href: '/projects/', label: `All ${allProjects.length} projects` }}
      />
      {lead && <FeaturedProject project={lead} />}
      {
        moreProjects.length > 0 && (
          <div style="margin-top:3.5rem">
            <CaseGrid items={moreProjects} />
          </div>
        )
      }
    </div>
  </section>

  <!-- 4. How I work -->
  <section class="section">
    <div class="container">
      <SectionHeader
        eyebrow="How I work"
        title="From first conversation to working system"
        intro="You do not need a technical specification to start. Describing the problem is enough. You deal with one person who understands the business requirement and the technical work, with developers and specialists brought in as the work requires."
      />
      <ProcessSteps steps={process} />
    </div>
  </section>

  <!-- 5. Where -->
  <section class="section section--soft">
    <div class="container">
      <SectionHeader
        eyebrow="Where I work"
        title="Based in Bangalore. Working hybrid, across borders."
        intro="I am based in Bangalore, India, and work hybrid: day-to-day delivery happens remotely, with site visits when a project needs them. I work with businesses in India, the UAE, New Zealand and beyond."
      />
      <div class="grid grid--2">
        {
          markets.map((m) => (
            <a class="card card--link market-card" href={`/${m.id}/`}>
              <span class="kicker">{m.data.country}</span>
              <h3>{m.data.title}</h3>
              <p>{m.data.summary}</p>
              <span class="card__foot">How I work with {shortCountry(m.data.country)} businesses →</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 6. Who -->
  <section class="section">
    <div class="container person">
      <div class="person__photo" aria-hidden="true">AP</div>
      <div>
        <span class="kicker">Who you will work with</span>
        <h2>Antony Pratap</h2>
        <p class="lead">
          Technology entrepreneur and implementation partner. I work directly with owners, founders and operations and
          finance leaders to understand the problem, choose the right approach and get it implemented. I also build
          software products of my own, so I face the same decisions my clients do.
        </p>
        <p><a href="/about/">More about me and how I work →</a></p>
      </div>
    </div>
  </section>

  {
    latest.length > 0 && (
      <section class="section section--soft">
        <div class="container">
          <SectionHeader eyebrow="Insights" title="Practical guidance" action={{ href: '/insights/', label: 'All articles' }} />
          <div class="grid grid--3">
            {latest.map((a) => (
              <ArticleCard article={a} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- 7. Start a conversation -->
  <CtaBand location="home-band" />
</Base>
