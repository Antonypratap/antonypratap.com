---
import Base from '../layouts/Base.astro';
import ArticleCard from '../components/ArticleCard.astro';
import CtaBand from '../components/CtaBand.astro';
import SystemsDiagram from '../components/SystemsDiagram.astro';
import ProjectRows from '../components/ProjectRows.astro';
import FeaturedProject from '../components/FeaturedProject.astro';
import { SITE, CTA } from '../data/site';
import { services, projects, articles } from '../data/content';

const allServices = await services();
const allProjects = await projects();
// Lead with the strongest featured project that has real screens; then a short list, never the whole catalogue.
const lead = allProjects.find((p) => p.data.featured && p.data.screenshots.length > 0) ?? allProjects[0];
const moreProjects = allProjects.filter((p) => p !== lead).slice(0, 4);
const latest = (await articles()).slice(0, 3);

const problems = [
  {
    title: 'Systems that do not talk to each other',
    text: 'Orders, stock, invoices and customer records live in separate applications, and people carry the data between them.',
  },
  {
    title: 'Skilled people doing repetitive work',
    text: 'Hours every week go on copying, checking, chasing and reconciling instead of running the business.',
  },
  {
    title: 'No reliable view of operations',
    text: 'Managers wait for exports and spreadsheets to know what is happening, so problems surface late.',
  },
  {
    title: 'Software that does not fit',
    text: 'Off-the-shelf tools force workarounds, and important processes still run on spreadsheets.',
  },
];

const principles = [
  {
    title: 'The business problem comes first',
    text: 'Technology is chosen to fit the problem: integrate, automate, configure or build, whichever is simplest and reliable.',
  },
  {
    title: 'One accountable person',
    text: 'You deal with someone who understands both the requirement and the technical work, and owns getting it delivered.',
  },
  {
    title: 'Working results in stages',
    text: 'Delivery in increments, tested with realistic data, so you see progress early and can change course cheaply.',
  },
  {
    title: 'Honest about what is proven',
    text: 'No invented figures, no borrowed logos. Projects are labelled for who owns them and how far they have got.',
  },
];
---

<Base title={SITE.title} fullTitle description={SITE.description}>
  <section class="hero hero--split">
    <div class="container">
      <div>
        <span class="kicker">For businesses in India and the UAE</span>
        <h1>Connect your systems. Automate the manual work. Run a calmer operation.</h1>
        <p class="lead">
          I help established and growing businesses streamline operations by connecting the software they already use,
          automating repetitive processes and building custom applications where nothing else fits.
        </p>
        <div class="actions">
          <a class="button" href={CTA.href} data-cta="home-hero">{CTA.label}</a>
          <a class="button button--ghost" href="#work">See the work</a>
        </div>
        <div class="hero__proof">
          <span><strong>Systems integration</strong></span>
          <span><strong>Process automation</strong></span>
          <span><strong>AI implementation</strong></span>
          <span><strong>Custom software</strong></span>
        </div>
      </div>
      <SystemsDiagram />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <span class="kicker">The problem</span>
      <h2>Where operations quietly lose time</h2>
      <p class="lead" style="margin-bottom:2.5rem">
        The symptoms are familiar long before anyone calls them a technology problem.
      </p>
      <ol class="rows">
        {
          problems.map((p, i) => (
            <li>
              <span class="rows__num">0{i + 1}</span>
              <h3>{p.title}</h3>
              <p>{p.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section section--ink">
    <div class="container">
      <p class="statement">
        Most of these problems are not solved by more software. They are solved by <em>making the systems you already
        have work together</em>, removing the steps nobody needs, and building only what is missing.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <span class="kicker">How I help</span>
      <h2>Six ways to solve operational problems</h2>
      <p class="lead" style="margin-bottom:2.5rem">Most projects combine several. Start with the one you recognise.</p>
      <ul class="rows rows--plain">
        {
          allServices.map((s) => (
            <li>
              <h3>
                <a href={`/services/${s.id}/`}>{s.data.shortTitle}</a>
              </h3>
              <p>{s.data.summary}</p>
              <a class="rows__more" href={`/services/${s.id}/`} aria-hidden="true" tabindex="-1">
                Learn more →
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--soft" id="work">
    <div class="container">
      <span class="kicker">Proof of work</span>
      {lead && <FeaturedProject project={lead} />}
      {
        moreProjects.length > 0 && (
          <>
            <h3 style="margin-top:4rem">More work</h3>
            <ProjectRows items={moreProjects} />
          </>
        )
      }
      <p class="actions"><a href="/projects/">All {allProjects.length} projects and products →</a></p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <span class="kicker">Working together</span>
      <h2>What you can expect</h2>
      <p class="lead" style="margin-bottom:2.5rem">
        Larger technology projects succeed or fail on clarity and ownership more than on code.
      </p>
      <ul class="principles">
        {
          principles.map((p) => (
            <li>
              <strong>{p.title}</strong>
              <span>{p.text}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container person">
      <div class="person__photo" aria-hidden="true">AP</div>
      <div>
        <span class="kicker">Who you will work with</span>
        <h2>Antony Pratap</h2>
        <p class="lead">
          Technology entrepreneur and implementation partner, working where business operations, software, integration
          and AI meet.
        </p>
        <p>
          I work directly with owners, founders and operations and finance leaders to understand the problem, choose the
          right approach and get it implemented, using AI-assisted development and coordinating developers and
          specialists where the work needs them. I also build products of my own, so I face the same decisions my
          clients do.
        </p>
        <p>
          I work with businesses in India and the United Arab Emirates, including Dubai and Abu Dhabi.
        </p>
        <p><a href="/about/">More about me and how I work →</a></p>
      </div>
    </div>
  </section>

  {
    latest.length > 0 && (
      <section class="section">
        <div class="container">
          <span class="kicker">Insights</span>
          <h2>Practical guidance</h2>
          <div class="grid grid--3" style="margin-top:2rem">
            {latest.map((a) => (
              <ArticleCard article={a} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <CtaBand location="home-band" />
</Base>
