---
import { render, getEntries } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaBand from '../../components/CtaBand.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import CaseGrid from '../../components/CaseGrid.astro';
import { projects } from '../../data/content';
import { breadcrumbSchema } from '../../data/schema';
import { CTA } from '../../data/site';

export async function getStaticPaths() {
  return (await projects()).map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { data } = project;
const { Content } = await render(project);
const relatedServices = await getEntries(data.services);
const countries = (await getEntries(data.markets)).map((m) => m.data.country);
const all = await projects();
// Next reads: projects sharing a service first, then the rest.
const shares = (p: (typeof all)[number]) => p.data.services.some((s) => data.services.some((d) => d.id === s.id));
const others = [...all.filter((p) => p.id !== project.id && shares(p)), ...all.filter((p) => p.id !== project.id && !shares(p))].slice(0, 3);
const path = `/projects/${project.id}/`;
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Projects', path: '/projects/' },
  { name: data.title, path },
];
const badgeClass = data.ownership === 'own-product' ? 'badge badge--own' : 'badge badge--client';
const facts = [
  { label: 'Ownership', value: data.ownershipLabel },
  { label: 'Status', value: data.status },
  { label: 'Industry', value: data.industries.join(', ') },
  { label: 'Country', value: countries.join(', ') },
  { label: 'Services', value: relatedServices.map((s) => s.data.shortTitle).join(', ') },
].filter((f) => f.value);
---

<Base title={data.metaTitle} fullTitle description={data.description} jsonLd={[breadcrumbSchema(crumbs)]}>
  <!-- 1. The case at a glance -->
  <section class="page-head">
    <div class="container">
      <Breadcrumbs items={crumbs} />
      <div class="badges">
        <span class={badgeClass}>{data.ownershipLabel}</span>
        {data.pseudonym && <span class="badge">Pseudonym</span>}
      </div>
      <h1>{data.title}</h1>
      <p class="lead">{data.summary}</p>
      <dl class="facts-bar">
        {
          facts.map((f) => (
            <div>
              <dt>{f.label}</dt>
              <dd>{f.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- 2. The story -->
  <section class="section">
    <div class="container story">
      <div class="prose">
        <Content />
      </div>
      <aside class="panel">
        <h2>Services involved</h2>
        <ul class="checklist">
          {
            relatedServices.map((s) => (
              <li>
                <a href={`/services/${s.id}/`}>{s.data.title}</a>
              </li>
            ))
          }
        </ul>
        <a class="button" href={CTA.href} data-cta={`project-${project.id}-aside`}>Discuss a similar project</a>
      </aside>
    </div>
  </section>

  <!-- 3. Evidence -->
  {
    data.screenshots.length > 0 && (
      <section class="section section--soft">
        <div class="container">
          <SectionHeader eyebrow="Inside the product" title="Screens" />
          <div class="grid" style="gap:2.5rem">
            {data.screenshots.map((shot) => (
              <figure class="shot">
                <div class="shot__bar" aria-hidden="true">
                  <span />
                  <span />
                  <span />
                </div>
                <Image src={shot.src} alt={shot.alt} widths={[640, 960, 1280, 1600]} sizes="(min-width: 1184px) 1120px, 100vw" />
                <figcaption>{shot.caption}</figcaption>
              </figure>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- 4. Next read -->
  <section class="section">
    <div class="container">
      <SectionHeader eyebrow="More work" title="Related projects" action={{ href: '/projects/', label: 'All projects' }} />
      <CaseGrid items={others} />
    </div>
  </section>

  <CtaBand location={`project-${project.id}-band`} heading="Working on something similar?" />
</Base>
