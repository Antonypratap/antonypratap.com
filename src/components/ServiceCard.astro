---
import type { CollectionEntry } from 'astro:content';
interface Props {
  service: CollectionEntry<'services'>;
  headingLevel?: 'h2' | 'h3';
}
const { service, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
---

<article class="card card--link">
  <Heading><a href={`/services/${service.id}/`}>{service.data.shortTitle}</a></Heading>
  <p>{service.data.summary}</p>
  <div class="card__foot"><a href={`/services/${service.id}/`} aria-hidden="true" tabindex="-1">How I help →</a></div>
</article>
