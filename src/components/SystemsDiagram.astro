---
// Hero illustration: business systems connected through one integration and automation layer,
// with only exceptions reaching a person. Inline SVG, so it costs no request and stays sharp.
const systems = [
  { x: 16, label: 'Website', sub: 'orders' },
  { x: 140, label: 'Inventory', sub: 'stock' },
  { x: 264, label: 'ERP', sub: 'accounts' },
  { x: 388, label: 'Payments', sub: 'gateway' },
];
---

<figure class="diagram">
  <svg viewBox="0 0 512 360" role="img" aria-labelledby="diagram-title diagram-desc">
    <title id="diagram-title">Connected business systems</title>
    <desc id="diagram-desc">
      Website, inventory, ERP and payment systems connected through one integration and automation layer that
      validates, syncs and reconciles data, sending only exceptions to your team.
    </desc>

    {
      systems.map((s) => (
        <g>
          <rect x={s.x} y="16" width="108" height="64" rx="8" class="d-node" />
          <text x={s.x + 54} y="44" class="d-label">{s.label}</text>
          <text x={s.x + 54} y="63" class="d-sub">{s.sub}</text>
          <line x1={s.x + 54} y1="80" x2={s.x + 54} y2="138" class="d-link" />
          <circle cx={s.x + 54} cy="138" r="4" class="d-dot" />
        </g>
      ))
    }

    <rect x="16" y="138" width="480" height="72" rx="10" class="d-layer" />
    <text x="256" y="168" class="d-layer-title">Integration and automation layer</text>
    <text x="256" y="190" class="d-layer-sub">validate · sync · reconcile · log</text>

    <line x1="256" y1="210" x2="256" y2="262" class="d-link d-link--alert" />
    <rect x="146" y="262" width="220" height="68" rx="8" class="d-node d-node--team" />
    <text x="256" y="291" class="d-label">Your team</text>
    <text x="256" y="311" class="d-sub">reviews only the exceptions</text>
  </svg>
</figure>

<style>
  .diagram {
    margin: 0;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 1.25rem;
    box-shadow:
      0 1px 2px rgb(15 28 43 / 0.04),
      0 18px 40px -18px rgb(15 28 43 / 0.25);
  }
  svg {
    width: 100%;
    height: auto;
    font-family: var(--font);
  }
  .d-node {
    fill: var(--bg-soft);
    stroke: #cfd4d9;
  }
  .d-node--team {
    fill: #fff7ed;
    stroke: #f2c9a1;
  }
  .d-label {
    fill: var(--ink);
    font-size: 15px;
    font-weight: 650;
    text-anchor: middle;
  }
  .d-sub {
    fill: var(--muted);
    font-size: 12px;
    text-anchor: middle;
  }
  .d-link {
    stroke: var(--accent);
    stroke-width: 2;
  }
  .d-link--alert {
    stroke: #c2410c;
    stroke-dasharray: 5 4;
  }
  .d-dot {
    fill: var(--accent);
  }
  .d-layer {
    fill: var(--bg-ink);
  }
  .d-layer-title {
    fill: #fff;
    font-size: 16px;
    font-weight: 650;
    text-anchor: middle;
  }
  .d-layer-sub {
    fill: #9fc9cb;
    font-size: 12.5px;
    letter-spacing: 0.04em;
    text-anchor: middle;
  }
</style>
