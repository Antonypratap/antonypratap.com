---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
interface Props {
  project: CollectionEntry<'projects'>;
}
const { project } = Astro.props;
const { data } = project;
const shot = data.screenshots[0];
const href = `/projects/${project.id}/`;
---

<div class={shot ? 'feature' : ''}>
  <div>
    <p class="badges">
      <span class={data.ownership === 'own-product' ? 'badge badge--own' : 'badge badge--client'}>{data.ownershipLabel}</span>
      {data.status && <span class="badge">{data.status}</span>}
    </p>
    <h2><a href={href} class="plain-link">{data.headline ?? data.title}</a></h2>
    <p class="lead">{data.summary}</p>
    <p><a href={href}>Read the case study →</a></p>
  </div>
  {
    shot && (
      <figure class="shot">
        <div class="shot__bar" aria-hidden="true">
          <span />
          <span />
          <span />
        </div>
        <Image src={shot.src} alt={shot.alt} widths={[640, 960, 1280]} sizes="(min-width: 980px) 640px, 100vw" />
        <figcaption>{shot.caption}</figcaption>
      </figure>
    )
  }
</div>
