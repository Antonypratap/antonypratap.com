---
import '@fontsource-variable/inter/wght.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Analytics from '../components/Analytics.astro';
import { SITE, ENV, IS_PRODUCTION } from '../data/site';
import { personSchema, websiteSchema } from '../data/schema';

interface Props {
  title: string;
  description: string;
  /** Full title is used as is; otherwise " | Antony Pratap" is appended. */
  fullTitle?: boolean;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
  publishedTime?: Date;
  modifiedTime?: Date;
}

const {
  title,
  description,
  fullTitle = false,
  ogType = 'website',
  noindex = false,
  jsonLd = [],
  publishedTime,
  modifiedTime,
} = Astro.props;

const pageTitle = fullTitle ? title : `${title} | ${SITE.name}`;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const ogImage = new URL('/og-default.png', SITE.url).href;
const robots = noindex || !IS_PRODUCTION ? 'noindex, nofollow' : 'index, follow, max-image-preview:large';
const graph = { '@context': 'https://schema.org', '@graph': [personSchema(), websiteSchema(), ...jsonLd] };
---

<!doctype html>
<html lang={SITE.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {Astro.url.pathname !== '/404/' && <link rel="canonical" href={canonical} />}
    <meta name="robots" content={robots} />
    <meta name="author" content={SITE.name} />
    <meta name="theme-color" content="#0f1c2b" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name}: Insights`} href="/insights/rss.xml" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_GB" />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {ENV.gscVerification && <meta name="google-site-verification" content={ENV.gscVerification} />}

    <script type="application/ld+json" set:html={JSON.stringify(graph)} />
    <script is:inline>
      // Open every newly visited page at the top. Some embedded viewers (such as previews) carry
      // the previous scroll position over; back and forward navigation keep the browser's own.
      (function () {
        var nav = performance.getEntriesByType && performance.getEntriesByType('navigation')[0];
        if (location.hash || (nav && nav.type === 'back_forward')) return;
        var top = function () {
          window.scrollTo({ top: 0, left: 0, behavior: 'instant' });
        };
        top();
        addEventListener('DOMContentLoaded', top);
        addEventListener('load', top);
      })();
    </script>
    <Analytics />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
